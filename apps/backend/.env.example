# Copy to .env and adjust. All values are optional; sane defaults are used.

# Address the HTTP server binds to.
MISU_BIND=0.0.0.0:8080

# MySQL connection. Create the database before starting the service; SQLx applies
# the tables and indexes automatically. Use the private endpoint in cloud hosting.
MISU_DB_HOST=127.0.0.1
MISU_DB_PORT=3306
MISU_DB_USER=misu
MISU_DB_PASSWORD=
MISU_DB_NAME=misu

# Vite production output for the Preact SPA/PWA.
MISU_SPA_DIR=../spa/dist

# Directory holding static assets (logos, QR codes, print images).
MISU_STATIC_DIR=static

# DEV auth mode. Explicit opt-in (1/true/yes/on). When on, /api/auth/wechat treats
# the login `code` as a stable fake openid so you can test without WeChat.
# NEVER enable in production.
MISU_DEV_MODE=

# Session-cookie transport policy. Use 0 only for local plain-HTTP development.
# Production HTTPS deployments must use 1.
MISU_COOKIE_SECURE=0

# WeChat mini program credentials. When BOTH are set, /api/auth/wechat calls
# WeChat's jscode2session. In DEV mode the login `code` is treated as a stable
# fake openid so you can test without WeChat.
WECHAT_APPID=
WECHAT_SECRET=

RUST_LOG=info,misu_backend=debug
