.auth-title { display: block; font-size: 40rpx; font-weight: 600; margin-bottom: 20rpx; }
.auth-note { display: block; color: #595960; font-size: 27rpx; line-height: 1.6; margin-bottom: 24rpx; }
.auth-label { display: block; font-size: 28rpx; margin: 24rpx 0 12rpx; }
.auth-input { box-sizing: border-box; width: 100%; height: 88rpx; padding: 16rpx 20rpx; background: #f5f5f7; border: 2rpx solid #ceced3; border-radius: 12rpx; }
.auth-submit { margin-top: 32rpx; background: #5b2a86; color: white; font-size: 30rpx; }
.auth-secondary { margin-top: 20rpx; background: #f0ecf6; color: #5b2a86; font-size: 27rpx; white-space: normal; line-height: 1.5; padding: 22rpx 16rpx; }
.auth-error { display: block; margin-top: 24rpx; color: #ad1721; font-size: 27rpx; }
