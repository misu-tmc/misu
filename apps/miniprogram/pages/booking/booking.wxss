.booking-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 10rpx 0;
  border-bottom: 1rpx solid #f0f0f2;
}
.booking-row:last-child { border-bottom: none; }
.booking-info { display: flex; flex: 1; min-width: 0; flex-direction: column; }
.booking-title { font-size: 30rpx; font-weight: 500; overflow-wrap: break-word; }
.booking-date { font-size: 24rpx; margin-top: 4rpx; }
.booking-actions { display: flex; flex: 0 0 auto; align-items: center; gap: 12rpx; }
.cancel-x {
  flex: 0 0 auto;
  width: 56rpx;
  height: 56rpx;
  line-height: 52rpx;
  text-align: center;
  border-radius: 50%;
  color: #b00020;
  background: #fbeaec;
  font-size: 36rpx;
}

.card-header { display: flex; align-items: center; margin-bottom: 12rpx; }
.fold-toggle {
  flex: 0 0 auto;
  width: 52rpx;
  height: 52rpx;
  line-height: 48rpx;
  margin-right: 16rpx;
  border-radius: 50%;
  text-align: center;
  background: #f0ecf6;
  color: #5b2a86;
  font-size: 36rpx;
  font-weight: 600;
}
.card-title { display: flex; flex-direction: column; min-width: 0; }
.card-number { font-size: 32rpx; font-weight: 600; }
.card-theme { font-size: 26rpx; margin-top: 4rpx; }

.role-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 10rpx 0;
  border-top: 1rpx solid #f0f0f2;
}
.role-label { flex: 1; min-width: 0; color: #3a3a3c; overflow-wrap: break-word; }
.role-taker { flex: 0 1 48%; min-width: 0; color: #6b6b70; text-align: right; overflow-wrap: break-word; }
.role-taker.mine { color: #5b2a86; font-weight: 600; }

/* Shrink the Take! button so a bookable row matches the height of a taken (text) row. */
.role-row .btn { flex: 0 0 auto; padding-top: 4rpx; padding-bottom: 4rpx; }

@media (max-width: 360px) {
  .booking-row { align-items: flex-start; }
  .booking-actions { gap: 8rpx; }
  .booking-actions .btn { padding-left: 18rpx; padding-right: 18rpx; }
  .role-row { gap: 12rpx; }
}
