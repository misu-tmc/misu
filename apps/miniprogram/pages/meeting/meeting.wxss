.title-card { display: flex; flex-direction: column; }
.title-head { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; }
.title-line { flex: 1; font-size: 32rpx; font-weight: 600; }
.edit-link { color: #5b2a86; font-size: 26rpx; font-weight: 600; white-space: nowrap; }
.title-sub { color: #6b6b70; font-size: 26rpx; margin-top: 6rpx; }
.actions {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 24rpx;
}
.btn-checked {
  background: #2e7d32;
  color: #fff;
}
.btn-timer-on {
  background: #1565c0;
  color: #fff;
}

.meeting-details { display: flex; gap: 24rpx; }
.meeting-detail { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 6rpx; }
.meeting-detail-label { color: #8a8a8f; font-size: 22rpx; font-weight: 600; text-transform: uppercase; letter-spacing: 1rpx; }
.meeting-detail-value { font-size: 28rpx; overflow-wrap: break-word; }

.section-header { display: flex; align-items: center; margin-bottom: 16rpx; }
.fold-toggle {
  flex: 0 0 auto;
  width: 52rpx;
  height: 52rpx;
  line-height: 48rpx;
  margin-right: 16rpx;
  border-radius: 50%;
  text-align: center;
  background: #f0ecf6;
  color: #5b2a86;
  font-size: 36rpx;
  font-weight: 600;
}
.section-title-inline { font-size: 28rpx; font-weight: 600; color: #6b6b70; text-transform: uppercase; letter-spacing: 1rpx; }

.agenda-row {
  display: flex;
  align-items: flex-start;
  padding: 16rpx 0;
  border-top: 1rpx solid #f0f0f2;
}
.agenda-row:first-child { border-top: none; }
.agenda-row.running { background: #f4f9ff; margin: 0 -12rpx; padding-left: 12rpx; padding-right: 12rpx; border-radius: 12rpx; }
.agenda-time {
  width: 110rpx;
  color: #5b2a86;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
}
.agenda-main { display: flex; flex-direction: column; flex: 1; }
.agenda-name { font-size: 30rpx; }
.agenda-meta { font-size: 24rpx; margin-top: 4rpx; }
.timer-actions { display: flex; align-items: center; gap: 10rpx; margin-left: 12rpx; }
.timer-btn {
  width: 52rpx;
  height: 52rpx;
  line-height: 48rpx;
  text-align: center;
  border-radius: 50%;
  background: #f0ecf6;
  color: #5b2a86;
  font-size: 26rpx;
  font-weight: 700;
}
.timer-btn.restart { background: #fff3e0; color: #b26a00; }
.timer-btn.add { background: #e8f5e9; color: #2e7d32; }

.speech-row { padding: 20rpx 0; border-top: 1rpx solid #f0f0f2; }
.speech-row:first-child { padding-top: 0; border-top: none; }
.speech-row:last-child { padding-bottom: 0; }
.speech-head { display: flex; align-items: baseline; justify-content: space-between; gap: 20rpx; }
.speech-title { flex: 1; min-width: 0; font-size: 30rpx; font-weight: 600; overflow-wrap: break-word; }
.speech-speaker { flex-shrink: 0; font-size: 24rpx; }
.speech-meta { display: block; margin-top: 4rpx; font-size: 24rpx; }
.speech-detail { display: flex; flex-direction: column; gap: 4rpx; margin-top: 16rpx; }
.speech-detail-label { font-size: 22rpx; font-weight: 600; text-transform: uppercase; letter-spacing: 1rpx; }
.speech-detail-value { font-size: 26rpx; line-height: 1.5; overflow-wrap: break-word; }
