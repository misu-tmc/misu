.container { padding-bottom: 168rpx; }

.vote-head { display: flex; flex-direction: column; gap: 8rpx; }
.vote-title { font-size: 34rpx; font-weight: 700; }
.vote-sub { font-size: 26rpx; color: #6b6b70; }

.empty-state { text-align: center; padding: 40rpx 24rpx; }
.group-title { display: block; font-size: 30rpx; font-weight: 600; margin-bottom: 16rpx; }

.vote-group { margin-bottom: 20rpx; }
.candidate {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 8rpx;
  border-top: 1rpx solid #f0f0f2;
}
.candidate:first-child { border-top: none; }
.candidate-active { background: #f6f1fb; border-radius: 12rpx; }

.dot {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 30rpx;
  height: 30rpx;
  border-radius: 50%;
  border: 2rpx solid #b8b8be;
  background: #fff;
  flex: 0 0 auto;
}
.dot-active { border-color: #5b2a86; background: #fff; }
.dot-inner {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: transparent;
}
.dot-inner-active { background: #5b2a86; }

.candidate-main { display: flex; flex-direction: column; min-width: 0; }
.candidate-name { font-size: 30rpx; }
.candidate-role { font-size: 24rpx; margin-top: 2rpx; }

.savebar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-top: 1rpx solid #ececee;
  z-index: 20;
}
.save-hint { flex: 1; font-size: 22rpx; }
.save-btn { padding: 20rpx 34rpx; }
.result-btn {
  background: #fff;
  color: #5b2a86;
  border: 2rpx solid #5b2a86;
  padding: 18rpx 28rpx;
}
.save-btn.disabled { opacity: 0.5; }
